# Matrix Server Configuration
# Copy this file to .env and update values for your environment

# ============================================
# Server Configuration (REQUIRED)
# ============================================
# Matrix server name - domain/IP shown in user IDs
# Examples: matrix.example.com, 8.217.143.228
MATRIX_SERVER_NAME=8.217.143.228

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=synapse
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=synapse
POSTGRES_PORT=5432

# ============================================
# Synapse Ports
# ============================================
SYNAPSE_HTTP_PORT=18008
SYNAPSE_HTTPS_PORT=8448

# ============================================
# Element Web Port
# ============================================
ELEMENT_PORT=8010

# ============================================
# Ketesa Admin UI Port
# ============================================
KETESA_PORT=8012

# ============================================
# Registration Secret (REQUIRED)
# ============================================
# Used by Backend to register Matrix accounts programmatically
# Generate with: openssl rand -hex 32
REGISTRATION_SHARED_SECRET=CHANGE_ME_TO_RANDOM_STRING

# ============================================
# Admin User (for first start)
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_ADMIN_PASSWORD
