{
  "$schema": "https://opencode.ai/config.json",
  "model": "tencent-coding-plan/glm-5",
  "small_model": "tencent-coding-plan/minimax-m2.5",
  "enabled_providers": ["zai-coding-plan", "tencent-coding-plan"],
  "plugin": ["oh-my-openagent", "opencode-image-fallback"],
  "autoupdate": true,
  "permission": "allow",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"]
    }
  }
}
